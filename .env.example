# SPDX-License-Identifier: Apache-2.0
# Copier en .env (ignoré par Git) pour brancher docker compose sur VOTRE fournisseur
# d'identité. Sans .env, les valeurs par défaut visent le Keycloak de dev facultatif
# (service `keycloak` à décommenter dans docker-compose.yml).
#
# À déclarer chez l'IdP : deux clients OIDC (portail et administration), URLs de retour
#   https://sesame.localhost:8443/auth/callback        (portail)
#   https://admin.sesame.localhost:8443/auth/callback  (administration)
# Référence complète des variables, y compris SAML : docs/configuration.md.

# Émetteur OIDC (discovery : <issuer>/.well-known/openid-configuration).
# Entra ID : https://login.microsoftonline.com/<tenant-id>/v2.0
SESAME_OIDC_ISSUER=https://idp.example/realms/exemple

SESAME_OIDC_PORTAL_CLIENT_ID=sesame-portal
SESAME_OIDC_PORTAL_CLIENT_SECRET=a-remplacer
SESAME_OIDC_ADMIN_CLIENT_ID=sesame-admin
SESAME_OIDC_ADMIN_CLIENT_SECRET=a-remplacer

# Claim servant de clé utilisateur (coffre, registre) : sub, ou oid pour Entra ID.
SESAME_OIDC_USER_KEY_CLAIM=sub
SESAME_OIDC_GROUPS_CLAIM=groups

# Groupe des administrateurs Sesame, tel qu'il apparaît dans le claim de groupes
# (Entra ID : identifiant GUID du groupe, pas son nom).
SESAME_ADMIN_GROUP=sesame-admins

# Déconnexion aussi chez l'IdP (RP-Initiated Logout).
SESAME_OIDC_LOGOUT=false
