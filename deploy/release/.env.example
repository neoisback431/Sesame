# SPDX-License-Identifier: Apache-2.0
# Configuration de Sesame. ./generate-keys.sh copie ce fichier en .env et remplit la
# section 3 ; renseignez ensuite la section 1. Référence complète : docs/configuration.md.

# ── 1. À renseigner ─────────────────────────────────────────────────────────────

# Domaine de Sesame. DNS : <domaine> et *.<domaine> doivent pointer vers ce serveur.
#   https://<domaine>          portail « Mes applications »
#   https://admin.<domaine>    administration
#   https://<appli>.<domaine>  chaque application protégée
SESAME_DOMAIN=sesame.example.com

# Fournisseur d'identité (OIDC). Déclarez-y deux clients avec ces URLs de retour :
#   portail        https://<domaine>/auth/callback
#   administration https://admin.<domaine>/auth/callback
# Entra ID : https://login.microsoftonline.com/<tenant-id>/v2.0
SESAME_OIDC_ISSUER=
SESAME_OIDC_PORTAL_CLIENT_ID=
SESAME_OIDC_PORTAL_CLIENT_SECRET=
SESAME_OIDC_ADMIN_CLIENT_ID=
SESAME_OIDC_ADMIN_CLIENT_SECRET=

# Groupe (claim « groups ») dont les membres accèdent à l'administration.
# Entra ID : le claim contient le GUID du groupe (Object Id), PAS son nom. Mettez ce GUID ici,
# et activez les groupes dans l'application Entra : « Configuration du jeton » → « Ajouter une
# revendication de groupes » (ou "groupMembershipClaims": "SecurityGroup" dans le manifeste).
SESAME_ADMIN_GROUP=sesame-admins

# ── 2. Facultatif ───────────────────────────────────────────────────────────────

# Version des images (tag de release). « latest » par défaut.
SESAME_VERSION=latest
# Registre des images (à changer seulement pour des images publiées par un fork).
# SESAME_REGISTRY=ghcr.io/neoisback431

# Claim servant de clé utilisateur : c'est la valeur saisie dans l'administration pour
# créer le compte d'un utilisateur. sub par défaut ; Entra ID : oid (identifiant d'objet
# de l'utilisateur, stable et identique pour le portail et l'administration).
SESAME_OIDC_USER_KEY_CLAIM=sub
SESAME_OIDC_GROUPS_CLAIM=groups

# Mise au point d'une appli qui ne se connecte pas : l'administration affiche la réponse
# de l'appli au dernier essai (valeurs sensibles masquées). À désactiver ensuite.
SESAME_REPLAY_DEBUG=false

# Notifications par mail (facultatif) : serveur, expéditeur et destinataires se règlent dans la
# console d'administration (« Notifications ») ; seul le mot de passe SMTP se met ici.
# SESAME_SMTP_PASSWORD=

# ── 3. Générées par ./generate-keys.sh ──────────────────────────────────────────
# Ne plus les modifier ensuite : changer SESAME_SECRETS_ENCRYPTION_KEY rend illisibles
# les identifiants applicatifs déjà enregistrés. Sauvegardez ce fichier.
POSTGRES_PASSWORD=
SESAME_PORTAL_STATE_KEY=
SESAME_SESSION_ENCRYPTION_KEY=
SESAME_SECRETS_ENCRYPTION_KEY=
SESAME_ADMIN_SESSION_KEY=
SESAME_RECORDER_TOKEN=
SESAME_INTERNAL_TOKEN=
